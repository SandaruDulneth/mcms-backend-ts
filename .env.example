NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mcms
CLIENT_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:8000
# Set to true only when you need full error stack traces in development logs.
LOG_STACKS=false
# Optional: used for NewsAPI-based credibility/news checks
NEWS_API_KEY=
# External intelligence testing
# false = use real GDACS/NewsAPI. true = return mock GDACS + NewsAPI matches for demo/testing.
EXTERNAL_INTEL_MOCK=false

# Default production target is Sri Lanka. For live GDACS testing you can temporarily use Vietnam:
# EXTERNAL_INTEL_COUNTRY_NAME=Vietnam
# EXTERNAL_INTEL_COUNTRY_ISO3=VNM
EXTERNAL_INTEL_COUNTRY_NAME=Sri Lanka
EXTERNAL_INTEL_COUNTRY_ISO3=LKA

# Administrator authentication credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET=
